# Local server binding. Keep 127.0.0.1 for direct local use.
HOST=127.0.0.1
PORT=8787
EVALHUB_DATA_DIR=./data

# Optional. If omitted, EvalHub creates a random key under EVALHUB_DATA_DIR.
# Use a long random value and keep it out of source control.
EVALHUB_MASTER_KEY=replace-with-a-long-random-value
