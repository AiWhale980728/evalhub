{
  "name": "evalhub",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "dev:server": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/core.test.mjs tests/api.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check": "npm run test && npm run build && npm run test:sites"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "^6.4.3"
  }
}
